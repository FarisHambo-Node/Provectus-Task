AWS_REGION=us-east-1
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_DIMENSIONS=1024
OPENSEARCH_HOST=search-your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=rag-chunks
# es = managed OpenSearch domain, aoss = OpenSearch Serverless
OPENSEARCH_SERVICE=es
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_SIMILARITY=0.25

# Tool execution
TOOL_TIMEOUT_S=8.0
TOOL_MAX_ATTEMPTS=3
TOOL_MAX_CONCURRENCY=4

# Orchestration
ENABLE_WEB_SEARCH=true
MAX_TOOL_CALLS_PER_TURN=4

# Conversation memory. Turns inside the window stay verbatim; older ones are
# folded into a rolling summary. summarize_after must exceed the window.
HISTORY_WINDOW_TURNS=6
SUMMARIZE_AFTER_TURNS=8
SUMMARY_MAX_CHARS=1200

# Checkpointing. memory = per-process, sqlite = durable file.
CHECKPOINT_BACKEND=memory
CHECKPOINT_PATH=.agent_checkpoints.sqlite
CHECKPOINT_TIMEOUT_S=3.0
CHECKPOINT_MAX_ATTEMPTS=3
# Fail open: a store outage degrades the conversation to stateless rather than
# failing the request. Set to false to make checkpoint errors fatal instead.
CHECKPOINT_FAIL_OPEN_READS=true
CHECKPOINT_FAIL_OPEN_WRITES=true

# Simulation knobs, drop these once Bedrock and OpenSearch are wired in
SIMULATE_LATENCY=true
SIMULATED_FAILURE_RATE=0.0
# RANDOM_SEED=42

LOG_LEVEL=INFO
LOG_FORMAT=json
