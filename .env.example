AWS_REGION=us-east-1
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_DIMENSIONS=1024
OPENSEARCH_HOST=search-your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_INDEX=rag-chunks
# es = managed OpenSearch domain, aoss = OpenSearch Serverless
OPENSEARCH_SERVICE=es
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_SIMILARITY=0.25

# Tool execution
TOOL_TIMEOUT_S=8.0
TOOL_MAX_ATTEMPTS=3
TOOL_MAX_CONCURRENCY=4

# Orchestration
ENABLE_WEB_SEARCH=true
MAX_TOOL_CALLS_PER_TURN=4
HISTORY_WINDOW_TURNS=6

# Simulation knobs, drop these once Bedrock and OpenSearch are wired in
SIMULATE_LATENCY=true
SIMULATED_FAILURE_RATE=0.0
# RANDOM_SEED=42

LOG_LEVEL=INFO
LOG_FORMAT=json
